# High-Performance Product Catalog API Configuration
# Server
PORT=8000
HOST=0.0.0.0
DEBUG=false
SERVICE_NAME="Product Catalog API"

# MySQL Primary Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=catalog_db
DB_SOCKET=/tmp/mysql3307.sock
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis In-Memory Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT_SECONDS=2.0

# Cache TTLs (Seconds)
CACHE_TTL_PRODUCT=300
CACHE_TTL_LIST=60
CACHE_TTL_METADATA=900
CACHE_MUTEX_TTL=5

# Security
ADMIN_API_KEY=catalog-admin-secret-key-at-least-32-chars-long
